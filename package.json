{
  "name": "ainews-lab-briefing",
  "version": "0.1.0",
  "private": true,
  "description": "A source-grounded, provider-agnostic AI news podcast script pipeline.",
  "type": "module",
  "bin": {
    "ainews": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "docker:build": "docker compose build ainews",
    "docker:smoke": "docker compose run --rm ainews sources --config config/editorial.json",
    "dev": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/src/cli.js",
    "test": "node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "fast-xml-parser": "^5.2.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
